const getAdjustedWidths = (
    containerWidth: number,
    leftPercent: number,
    centerPercent: number,
    rightPercent: number
) => {
    if (containerWidth <= 0) {
        return {
            adjustedLeftWidth: leftPercent,
            adjustedCenterWidth: centerPercent,
            adjustedRightWidth: rightPercent,
        }
    }

    const dividerPixelWidth = 6
    const totalDividerWidthPx = dividerPixelWidth * 2
    const dividerWidthPercent = (totalDividerWidthPx / containerWidth) * 100
    const availableWidthPercent = 100 - dividerWidthPercent

    const totalDesiredPercent = leftPercent + centerPercent + rightPercent
    const scaleFactor = availableWidthPercent / totalDesiredPercent

    const adjustedLeftWidth = leftPercent * scaleFactor
    const adjustedCenterWidth = centerPercent * scaleFactor
    const adjustedRightWidth = rightPercent * scaleFactor

    return { adjustedLeftWidth, adjustedCenterWidth, adjustedRightWidth }
}

const ErrorBoundary = ({ children }: { children: ReactNode }) => {
    const [hasError, setHasError] = useState(false)
    const [error, setError] = useState<Error | null>(null)
    useEffect(() => {
        const handleError = (event: ErrorEvent) => {
            setHasError(true)
            setError(new Error(event.message))
            console.error(
                "Error caught in ErrorBoundary:",
                event.message,
                event.error?.stack || event.error
            )
        }
        window.addEventListener("error", handleError)
        return () => window.removeEventListener("error", handleError)
    }, [])
    if (hasError) {
        return (
            <div style={{ padding: 20, color: "white", background: "#151515" }}>
                <h1>Something went wrong.</h1>
                <p>{error?.message || "Unknown error occurred."}</p>
                <p>Please refresh the page or contact support.</p>
            </div>
        )
    }
    return <>{children}</>
}

